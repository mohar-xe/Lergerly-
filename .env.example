# Ledgerly API Base URL (Configured when Amazon API Gateway is deployed)
VITE_API_BASE_URL=

# WhatsApp Cloud API (Meta Graph API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ledgerly_verify_2026
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v18.0
DEFAULT_SHOP_ID=shop001
SHOP_PHONE_MAP={"YOUR_PHONE_NUMBER_ID":"shop001"}

# Voice Transcription (AWS Transcribe – DEMO: Top 5 Indian + English)
TRANSCRIBE_S3_BUCKET=ledgerly-whatsapp-audio
TRANSCRIBE_LANGUAGE=auto
# Demo supported: auto (detect among 6) or explicit: en-IN, hi-IN, bn-IN, mr-IN, ta-IN, te-IN
# Other languages (gu, kn, ml, pa, or, ne, as, sa, sd, ur, brx, doi, etc) -> yet to be implemented (400)
TRANSCRIBE_PROVIDER=aws
MAX_VOICE_BYTES=10485760
SUPPORTED_AWS_LANGS=en-IN,hi-IN,bn-IN,mr-IN,ta-IN,te-IN

# Whisper Fallback (disabled in demo – other langs yet to be implemented)
WHISPER_PROVIDER=
WHISPER_ENDPOINT_URL=
HF_TOKEN=
OPENAI_API_KEY=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_VERIFY_TOKEN=ledgerly_telegram_verify_2026
TELEGRAM_SHOP_MAP={"YOUR_TELEGRAM_BOT_ID":"shop001"}

# WhatsApp Send Retries (Exponential backoff for transient 429/5xx Graph API errors)
WHATSAPP_SEND_MAX_RETRIES=2
WHATSAPP_SEND_RETRY_BACKOFF_BASE=0.2

# DynamoDB Data Layer (Deterministic ledger)
CUSTOMERS_TABLE=Customers
TRANSACTIONS_TABLE=Transactions
# DYNAMODB_ENDPOINT_URL=http://localhost:8000 # for local testing

# Bedrock (Demo: Top 5 Indian + English)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1
DEMO_LANGUAGES=en-IN,hi-IN,bn-IN,mr-IN,ta-IN,te-IN
